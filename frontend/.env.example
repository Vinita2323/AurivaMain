# Frontend App Configuration
VITE_APP_NAME="AURIVÁ Foods"
VITE_APP_ENV=development

# Local API URL belongs in `.env.development` only (never in shared `.env`).
# Production builds use same-origin: https://aurivabites.in/api/v1
# VITE_API_URL=http://localhost:7000/api/v1

# Live Shiprocket checkout rates (false = store settings fees; set true when SR is ready)
VITE_SHIPROCKET_CHECKOUT_ENABLED=true
