# Server Configuration
PORT=5000
NODE_ENV=development
# Comma-separated allowlist. Production example: https://aurivabites.in,https://www.aurivabites.in
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/auriva_db

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production_123456
JWT_EXPIRES_IN=7d

# SMS / OTP Provider (Optional / Placeholder)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=AURIVA
SMS_TEMPLATE_ID=your_template_id

# Razorpay Payment Gateway (Optional until live credentials are provided)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket Shipping (server-side only — never use VITE_ prefixes)
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# Pickup location nickname exactly as registered in Shiprocket (Auriva warehouse — NOT customer address)
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_CONTACT_PERSON=Auriva Warehouse
SHIPROCKET_PICKUP_PHONE=9876543210
SHIPROCKET_PICKUP_ADDRESS=Plot 14, Sanwer Road Industrial Area
SHIPROCKET_PICKUP_CITY=Indore
SHIPROCKET_PICKUP_STATE=Madhya Pradesh
SHIPROCKET_PICKUP_PINCODE=452015
SHIPROCKET_PICKUP_COUNTRY=India
SHIPROCKET_GSTIN=
# Optional shared secret sent as x-shiprocket-token or ?token= on webhook
SHIPROCKET_WEBHOOK_TOKEN=
# Public webhook path for Shiprocket dashboard (must NOT contain "shiprocket"/"sr"):
# POST https://YOUR_PUBLIC_DOMAIN/api/v1/webhooks/courier-updates
# Auth Token Type: x-api-key  |  Token: same value as SHIPROCKET_WEBHOOK_TOKEN
SHIPROCKET_AUTO_CREATE=true
# Checkout live rate quotes (false = store settings fees while testing)
SHIPROCKET_CHECKOUT_QUOTES=true
# Auto pipeline after COD/prepaid confirm: create | awb | full
# create = SR order only | awb = + AWB | full = create→AWB→pickup→label→invoice
SHIPROCKET_AUTO_FULFILL=create
# Optional package defaults (kg / cm) when product shipping fields are missing
SHIPROCKET_DEFAULT_WEIGHT_KG=0.2
SHIPROCKET_DEFAULT_LENGTH_CM=20
SHIPROCKET_DEFAULT_BREADTH_CM=15
SHIPROCKET_DEFAULT_HEIGHT_CM=8
